# Environment Configuration for &.events
HOST=127.0.0.1
PORT=8000
SCIEDU_CONTENT_DIR=

# Optional Google Gemini API Key for semantic event categorization & intent matching
GEMINI_API_KEY=
# Optional model override (fallback chain: gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-2.5-flash, gemini-2.0-flash-lite, gemini-1.5-flash)
GEMINI_MODEL=
# Set to 1 during test execution to bypass background sync loop
TESTING=0
